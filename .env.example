APP_NAME=Yolixa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file



BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# =========================================================
# DATABASE
# =========================================================

DB_CONNECTION=sqlite
DB_HOST=
DB_PORT=
DB_DATABASE=database/database.sqlite
DB_USERNAME=
DB_PASSWORD=


# =========================================================
# SESSION / CACHE / QUEUE
# =========================================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=


# =========================================================
# REDIS / MEMCACHED
# =========================================================

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# =========================================================
# MAIL
# =========================================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# =========================================================
# AWS
# =========================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# =========================================================
# VITE
# =========================================================

VITE_APP_NAME="${APP_NAME}"


# =========================================================
# YOLIXA CORE
# =========================================================

YOLIXA_NETWORK=testnet
YOLIXA_TIP_EXECUTION_MODE=classic
YOLIXA_PLATFORM_FEE_PERCENT=0

# Future sustainability-fee treasury address. Not used by the current direct
# XLM tipping MVP.
YOLIXA_PLATFORM_WALLET_PUBLIC=

YOLIXA_MIN_PAYMENT_AMOUNT=0.0000001
YOLIXA_MAX_PAYMENT_AMOUNT=1000


# =========================================================
# STELLAR NETWORK
# =========================================================

STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_MAINNET_HORIZON_URL=https://horizon.stellar.org

STELLAR_TESTNET_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_MAINNET_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"

STELLAR_EXPLORER_TESTNET_TX_URL=https://stellar.expert/explorer/testnet/tx/{hash}
STELLAR_EXPLORER_MAINNET_TX_URL=https://stellar.expert/explorer/public/tx/{hash}

STELLAR_EXPLORER_TESTNET_ACCOUNT_URL=https://stellar.expert/explorer/testnet/account/{account}
STELLAR_EXPLORER_MAINNET_ACCOUNT_URL=https://stellar.expert/explorer/public/account/{account}


# =========================================================
# EXISTING YOLIXA FEATURE CONFIG
# =========================================================

# This can remain blank because config prefers
# YOLIXA_PLATFORM_WALLET_PUBLIC above.
YOLIXA_PLATFORM_PUBLIC_KEY=

YOLIXA_FEE_PERCENTAGE=

YOLIXA_ENABLED_WALLETS=freighter

YOLIXA_FEATURE_XLM_PAYMENTS=true
YOLIXA_FEATURE_ISSUED_ASSETS=false
YOLIXA_FEATURE_REVENUE_SPLITTING=false
YOLIXA_FEATURE_MAINNET=false

YOLIXA_ASSET_CODE=XLM
YOLIXA_ASSET_ISSUER=
YOLIXA_ASSET_DISPLAY_NAME="Stellar Lumens"
YOLIXA_ASSET_ENABLED=true

YOLIXA_WALLET_CHALLENGE_TTL_SECONDS=300


# =========================================================
# USDC
# =========================================================

USDC_ASSET_CODE=USDC
USDC_ISSUER_PUBLIC=


# =========================================================
# YLX
# =========================================================

YLX_ASSET_CODE=YLX
YLX_ISSUER_PUBLIC=
YLX_REWARD_RATE_PERCENT=0


# =========================================================
# OPTIONAL - FUTURE SOROBAN DEVELOPMENT
# Not required to run the current classic XLM MVP.
# =========================================================

SOROBAN_ENABLED=false

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Real deployed YolixaTipRouter C-address. Keep blank until a future Soroban
# payment-router milestone is deliberately enabled.
SOROBAN_TIP_ROUTER_CONTRACT_ID=

# Native Testnet XLM SAC contract C-address for the future Soroban router path.
SOROBAN_XLM_TOKEN_CONTRACT_ID=

SOROBAN_TIP_INTENT_TTL_MINUTES=30

# 150 basis points = 1.5%. Future only; the current MVP does not collect this fee.
SOROBAN_TIP_ROUTER_FEE_BPS=150

# A funded Testnet public G-address used for future read-only verification.
SOROBAN_VERIFIER_SOURCE_ACCOUNT=


# =========================================================
# OPTIONAL - FUTURE/EXPERIMENTAL SOROBAN REGISTRY
# Not used by the current classic MVP. Do not commit signer secrets.
# =========================================================

SOROBAN_TIP_REGISTRY_CONTRACT_ID=
SOROBAN_PLATFORM_SIGNER_PUBLIC=
